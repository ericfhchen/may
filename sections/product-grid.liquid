{%- comment -%} Fall back to all products until the client picks some in the editor {%- endcomment -%}
{%- assign products = section.settings.products -%}
{%- if products == blank -%}
  {%- assign products = collections.all.products -%}
{%- endif -%}
{%- assign product_count = products.size -%}

{%- comment -%} Rendered card width per layout, so the browser picks the right srcset size {%- endcomment -%}
{%- case product_count -%}
  {%- when 1 -%}
    {%- assign card_sizes = '(max-width: 800px) 100vw, 50vw' -%}
  {%- when 2 -%}
    {%- assign card_sizes = '(max-width: 480px) 100vw, (max-width: 800px) 50vw, 37vw' -%}
  {%- else -%}
    {%- assign card_sizes = '(max-width: 480px) 100vw, (max-width: 800px) 50vw, 33vw' -%}
{%- endcase -%}

{%- if product_count > 0 -%}
  <div class="product-grid-section">
    <div class="container">
      <div class="product-grid product-grid--count-{{ product_count }}">
        {%- for product in products -%}
          <div class="product-card" data-reveal>
            <a href="{{ product.url }}" class="product-card__link">
              <div class="product-card__image-wrapper">
                {%- assign first_media = product.media.first -%}
                {%- if first_media != blank -%}
                  {%- comment -%} First row is above the fold, so load it eagerly; the rest wait until scrolled near {%- endcomment -%}
                  {%- if forloop.index <= 3 -%}
                    {%- assign card_loading = 'eager' -%}
                  {%- else -%}
                    {%- assign card_loading = 'lazy' -%}
                  {%- endif -%}
                  {{ first_media | image_url: width: 1600, height: 1600, crop: 'center' | image_tag:
                    class: 'product-card__image',
                    widths: '400, 600, 800, 1000, 1200, 1600',
                    sizes: card_sizes,
                    loading: card_loading
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'product-card__image placeholder-svg' }}
                {%- endif -%}
                
                {% if product.available == false %}
                  <div class="product-card__sold-out">
                    <span>{{ 'products.product.sold_out' | t }}</span>
                  </div>
                {% elsif product.compare_at_price > product.price %}
                  <div class="product-card__sale">
                    <span>{{ 'products.product.on_sale' | t }}</span>
                  </div>
                {% endif %}
              </div>
              
              <div class="product-card__info">
                <div class="product-card__text-wrapper">
                  <p class="product-card__title">{{ product.title }}</p>
                  <div class="product-card__price">
                    {%- if product.compare_at_price > product.price -%}
                      <span class="product-card__price--sale">{{ product.price | money }}</span>
                      <span class="product-card__price--compare">{{ product.compare_at_price | money }}</span>
                    {%- else -%}
                      <span>{{ product.price | money }}</span>
                    {%- endif -%}
                  </div>
                </div>
                <div class="product-card__highlight"></div>
              </div>
            </a>
          </div>
        {%- endfor -%}
      </div>
      
      {% if section.settings.show_view_all and collections.all.products.size > product_count %}
        <div class="product-grid__view-all">
          <a href="/collections/all" class="btn">{{ 'collections.general.view_all' | t }}</a>
        </div>
      {% endif %}
    </div>
  </div>
{%- endif -%}

<style>
  /* ==========================================================================
   Product Grid
   ========================================================================== */
.product-grid-section {
  padding: 0.5rem 0.5rem;
  margin: 1.5rem 0 6rem 0;
}

/* Flex rather than grid so a partly filled last row centers instead of left-aligning */
.product-grid {
  --grid-columns: 3;
  --grid-gap: 40px;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: var(--grid-gap);
}

.product-grid > .product-card {
  flex: 0 0 calc((100% - (var(--grid-columns) - 1) * var(--grid-gap)) / var(--grid-columns));
  min-width: 0;
}

/* Adjust grid based on number of products */
.product-grid--count-1 {
  --grid-columns: 1;
  max-width: 50vw;
  margin: 0 auto;
}

.product-grid--count-2 {
  --grid-columns: 2;
  max-width: 75vw;
  margin: 0 auto;
}

.product-card {
  position: relative;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  border-radius: 8px;
  overflow: hidden;
}

.product-card__link {
  display: block;
  color: var(--text-color);
  text-decoration: none;
}

.product-card__image-wrapper {
  position: relative;
  width: 100%;
  padding-bottom: 100%; /* 1:1 Aspect Ratio */
  overflow: hidden;
  border-radius: 8px;
}

.product-card__image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease, opacity 300ms ease;
}

/* Hover: fade the image slightly */
.product-card__link:focus-visible .product-card__image {
  opacity: 0.9;
}

@media (hover: hover) {
  .product-card__link:hover .product-card__image {
    opacity: 0.9;
  }
}

.product-card__info {
  position: relative;
  padding: 20px 0;
}

.product-card__text-wrapper {
  display: flex;
  justify-content: left;
  align-items: center;
  flex-wrap: wrap;
  position: relative;
  z-index: 2;
  font-size: 1.5rem;
  line-height: 1;
  text-transform: uppercase;
  color: white;
}

.product-card__title {
  margin: 0;
  font-weight: bold;
  white-space: nowrap;
  background-color: var(--product-highlight-color);
  padding: 2px;
}

.product-card__price {
  font-weight: bold;
  background-color: var(--product-price-highlight-color);
  padding: 2px;
}

.product-card__price--sale {
  color: #e53935;
  margin-right: 5px;
}

.product-card__price--compare {
  color: #999;
  font-weight: normal;
  text-decoration: line-through;
  font-size: 0.9em;
  display: block;
}

.product-card__sold-out {
  display: none;
}

.product-grid__view-all {
  text-align: center;
  margin-top: 50px;
}

.product-grid__view-all .btn {
  padding: 12px 30px;
  font-weight: bold;
  text-transform: uppercase;
  letter-spacing: 1px;
  transition: all 0.3s ease;
  background-color: var(--product-highlight-color);
  color: var(--primary-color);
  border-radius: 30px;
}

.product-grid__view-all .btn:hover {
  opacity: 0.9;
  transform: translateY(-2px);
}

/* Responsive styles */
@media (max-width: 800px) {
  .product-grid {
    --grid-columns: 2;
    --grid-gap: 1rem;
    max-width: 100%;
  }
  
  .product-grid--count-1 {
    --grid-columns: 1;
  }
  
  .product-card__text-wrapper {
    font-size: 1.2rem;
  }
  
  .product-card__title {
    font-size: 1.2rem;
  }
  
  .product-card__price {
    font-size: 1.2rem;
  }
}

@media (max-width: 480px) {
  .product-grid {
    --grid-columns: 1;
    --grid-gap: 0px;
    width: 100%;
  }
  
  .product-grid--count-1,
  .product-grid--count-2 {
    --grid-columns: 1;
    max-width: 100%;
  }
  
  .product-grid-title {
    font-size: 24px;
    margin-bottom: 20px;
  }
  
  .product-card {
    width: 100%;
  }

  .product-card__info {
    padding-bottom: 0;
  }
  
  .product-card__title {
    font-size: 1rem;
    
  }
  
  .product-card__price {
    font-size: 1rem;
  }

  .product-card__text-wrapper {
    align-items: center;
  }
} 
</style>

{% schema %}
{
  "name": "Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Featured Products"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "info": "Choose products and drag to set their order. If none are selected, all products are shown.",
      "limit": 50
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Product Grid",
      "category": "Products"
    }
  ]
}
{% endschema %} 

