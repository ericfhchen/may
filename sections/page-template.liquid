{% render 'background-circles' %}

<div class="page-wrapper">
  <div class="page-container container">
    <div class="page-content rte">
      {{ page.content }}
    </div>
  </div>
</div>

<style>
  /* Hide scrollbar on Chrome for pages using this template */
  html::-webkit-scrollbar,
  body::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
    background: transparent;
  }
  
  html,
  body {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
  
  .page-wrapper {
    width: 100%;
    overflow-x: hidden;
    box-sizing: border-box;
  }
  
  .page-container {
    max-width: 100%;
    padding: 5rem 0.5rem;
    min-height: calc(100svh - 3rem);
    display: flex;
    align-items: center;
    box-sizing: border-box;
    width: 100%;
    position: relative;
  }
  
  .page-header {
    margin-bottom: 2rem;
    text-align: center;
  }
  
  .page-title {
    font-size: 2.5rem;
    line-height: 1.2;
  }
  
  .page-content {
    font-size: 1rem;
    line-height: 1.6;
    width: 100%;
    max-width: 100%;
    overflow-wrap: break-word;
    word-wrap: break-word;
    box-sizing: border-box;
  }
  
  /* Style for rich text elements */
  
  .rte h1, 
  .rte h2, 
  .rte h3, 
  .rte h4, 
  .rte h5, 
  .rte h6 {
    margin-top: 2em;
    margin-bottom: 1em;
  }
  
  .rte p {
    margin-bottom: 1.5em;
  }
  
  .rte ul, 
  .rte ol {
    padding-left: 2em;
    margin-bottom: 1.5em;
  }
  
  .rte img {
    max-width: 100%;
    width: 100%;
    height: auto;
    display: block;
    margin: 2em auto;
    box-sizing: border-box;
  }
  
  @media (max-width: 768px) {
    .page-title {
      font-size: 2rem;
    }
    
    .page-content {
      font-size: 0.9rem;
    }
  }
</style>

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %} 